<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="description" content="{{ description | escape }}">
<title>{{ title | escape }}</title>
<style>
{{ style }}</style>
</head>
<body>
<div class="container">
<header>
  <h1>{{ title | escape }}</h1>
  <p>Packman Essentials, rebuilt from public sources. Not affiliated with Packman or openSUSE.</p>
  <p>Packman <a href="https://lists.links2linux.de/pipermail/packman/2026-August/018314.html">shuts down</a> on 2026-12-31. This repo keeps the packages going.</p>
{%- if pipeline_api_url %}
  <p id="pipeline" class="pipeline" data-api="{{ pipeline_api_url | escape }}" hidden></p>
{%- endif %}
  <nav><a href="#install">Install</a><a href="#signing-key">Key</a><a href="#repository">Repo</a><a href="#packages">Packages</a>{% if source_url %}<a href="{{ source_url | escape }}">GitHub</a>{% endif %}</nav>
</header>

<main>
<section id="install">
  <h2>Install</h2>
  <ol class="steps">
{%- for command in commands %}
    <li>
      <p class="step-label">{{ command.label | escape }}</p>
      <div class="code-block">
        <pre id="{{ command.id }}"><code>{{ command.text | escape }}</code></pre>
        <button type="button" class="copy-btn" data-target="{{ command.id }}" hidden>Copy</button>
      </div>
    </li>
{%- endfor %}
  </ol>
  <p class="note">Step 3 replaces openSUSE and Packman builds with these.</p>
</section>

<section id="signing-key">
  <h2>Key</h2>
{%- if key %}
  <dl class="facts">
    <dt>Key ID</dt><dd><code>{{ key.id | escape }}</code></dd>
    <dt>Fingerprint</dt><dd><code>{{ key.fingerprint | escape }}</code></dd>
    <dt>File</dt><dd><a href="{{ key_url | escape }}">{{ key_url | escape }}</a></dd>
  </dl>
{%- else %}
  <p>No signing key recorded. <a href="{{ key_url | escape }}">{{ key_url | escape }}</a></p>
{%- endif %}
</section>

<section id="repository">
  <h2>Repo</h2>
  <dl class="facts">
    <dt>Repo file</dt><dd><a href="{{ repo_file_url | escape }}">{{ repo_file_url | escape }}</a></dd>
{%- for baseurl in baseurls %}
    <dt>{{ baseurl.arch | escape }}</dt><dd><code>{{ baseurl.url | escape }}</code></dd>
{%- endfor %}
    <dt>Tumbleweed</dt><dd>{% if tumbleweed_snapshot %}{{ tumbleweed_snapshot | escape }}{% else %}unknown{% endif %}</dd>
    <dt>Updated</dt><dd>{% if generated_at %}<time datetime="{{ generated_at_iso | escape }}">{{ generated_at | escape }}</time>{% else %}unknown{% endif %}</dd>
    <dt>Run</dt><dd>{{ run | escape }}{% if release %} <code>{{ release | escape }}</code>{% endif %}</dd>
    <dt>Packages</dt><dd>{{ totals.succeeded }} of {{ totals.packages }} built</dd>
    <dt>Files</dt><dd>{{ totals.binary_rpms }} rpms, {{ totals.source_rpms }} src, {{ totals.size }}</dd>
    <dt>JSON</dt><dd><a href="packages.json">packages.json</a></dd>
  </dl>
</section>

<section id="packages">
  <h2>Packages</h2>
  <table>
    <thead>
      <tr><th>Package</th><th>Version</th><th>Origin</th><th>Status</th><th>Built</th><th>Files</th></tr>
    </thead>
    <tbody>
{%- for package in packages %}
      <tr id="{{ package.anchor }}">
        <td data-label="Package"><a class="name" href="#{{ package.anchor }}">{{ package.name | escape }}</a></td>
        <td data-label="Version">{% if package.evr %}<code>{{ package.evr | escape }}</code>{% else %}<span class="muted">unknown</span>{% endif %}</td>
        <td data-label="Origin"><div>{% if package.origin_url %}<a href="{{ package.origin_url | escape }}">{{ package.origin_label | escape }}</a>{% else %}{{ package.origin_label | escape }}{% endif %}<span class="kind">{{ package.kind | escape }}</span></div></td>
        <td data-label="Status"><div><span class="status status-{{ package.status_class }}">{{ package.status | escape }}</span>{% if package.last_run %} <span class="muted">run {{ package.last_run | escape }}</span>{% endif %}{% if package.reason %}<span class="reason">{{ package.reason | escape }}</span>{% endif %}</div></td>
        <td data-label="Built">{% if package.built_at %}<time datetime="{{ package.built_at_iso | escape }}">{{ package.built_at | escape }}</time>{% else %}<span class="muted">never</span>{% endif %}</td>
        <td data-label="Files"><div>{% if package.files.size > 0 %}<button type="button" class="files-toggle" aria-expanded="false" aria-controls="files-{{ package.anchor }}" hidden>{{ package.files.size }} rpms</button>{% else %}<span class="muted">none</span>{% endif %}{% if package.retained %}<span class="reason">from last good build</span>{% endif %}</div></td>
      </tr>
{%- if package.files.size > 0 %}
      <tr class="files-row" id="files-{{ package.anchor }}">
        <td colspan="6"><ul class="files">{% for file in package.files %}<li><a href="{{ file.url | escape }}">{{ file.name | escape }}</a><span class="muted">{{ file.size }}</span></li>{% endfor %}</ul></td>
      </tr>
{%- endif %}
{%- endfor %}
    </tbody>
  </table>
</section>
</main>

<footer>
  <p>Some codecs may be patented where you live. Check your local laws.</p>
{%- if source_url %}
  <p>Source: <a href="{{ source_url | escape }}">{{ source_url | escape }}</a></p>
{%- endif %}
  <p>Inspired by <a href="https://omnipackage.org">omnipackage.org</a>.</p>
  <p>Run {{ run | escape }}{% if generated_at %}, {{ generated_at | escape }}{% endif %}.</p>
</footer>
</div>
<script>
var pipeline = document.getElementById('pipeline');
if (pipeline && window.fetch) {
  fetch(pipeline.dataset.api).then(function (response) {
    return response.ok ? response.json() : null;
  }).then(function (data) {
    var run = data && data.workflow_runs && data.workflow_runs[0];
    if (!run) return;
    var time = function (iso) { return iso.slice(0, 16).replace('T', ' ') + ' UTC'; };
    var words = { success: 'succeeded', failure: 'failed', timed_out: 'timed out', startup_failure: 'failed to start' };
    var running = run.status !== 'completed';
    var failed = ['failure', 'timed_out', 'startup_failure'].indexOf(run.conclusion) >= 0;
    var link = document.createElement('a');
    link.href = run.html_url;
    link.textContent = running ? 'Build #' + run.run_number + ' running since ' + time(run.run_started_at || run.created_at)
      : 'Last build #' + run.run_number + ' ' + (words[run.conclusion] || run.conclusion || run.status) + ', ' + time(run.updated_at);
    pipeline.appendChild(link);
    pipeline.classList.add(running ? 'pipeline-running' : failed ? 'pipeline-failed' : run.conclusion === 'success' ? 'pipeline-ok' : 'pipeline-other');
    pipeline.hidden = false;
  }).catch(function () {});
}
document.querySelectorAll('.files-toggle').forEach(function (button) {
  var row = document.getElementById(button.getAttribute('aria-controls'));
  row.hidden = true;
  button.hidden = false;
  button.addEventListener('click', function () {
    var open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    row.hidden = !open;
    button.closest('tr').classList.toggle('expanded', open);
  });
});
if (navigator.clipboard) {
  document.querySelectorAll('.copy-btn').forEach(function (button) {
    button.hidden = false;
    button.addEventListener('click', function () {
      var text = document.getElementById(button.dataset.target).textContent;
      navigator.clipboard.writeText(text).then(function () {
        button.textContent = 'Copied';
        button.classList.add('copied');
        setTimeout(function () {
          button.textContent = 'Copy';
          button.classList.remove('copied');
        }, 1500);
      });
    });
  });
}
</script>
</body>
</html>
