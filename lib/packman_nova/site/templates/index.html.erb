<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="description" content="<%= h description %>">
<title><%= h title %></title>
<link rel="canonical" href="<%= h site_url %>">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= h name %>">
<meta property="og:title" content="<%= h title %>">
<meta property="og:description" content="<%= h description %>">
<meta property="og:url" content="<%= h site_url %>">
<meta name="twitter:card" content="summary">
<script type="application/ld+json"><%= structured_data %></script>
<script>
try { document.documentElement.dataset.theme = localStorage.getItem('theme') || ''; } catch (e) {}
</script>
<style>
<%= style %></style>
</head>
<body>
<div class="container">
<header>
  <div class="theme-toggle" id="theme-toggle" hidden>
    <button type="button" data-mode="light">Light</button>
    <button type="button" data-mode="">Auto</button>
    <button type="button" data-mode="dark">Dark</button>
  </div>
  <h1><%= h title %></h1>
  <p><%= h description %> Not affiliated with Packman or openSUSE.</p>
  <p>Packman <a href="https://lists.links2linux.de/pipermail/packman/2026-August/018314.html">shuts down</a> on 2026-12-31. This repo keeps the packages going.</p>
  <p>All builds run on <% if source_url %><a href="<%= h source_url %>/actions">GitHub Actions</a><% else %>GitHub Actions<% end %>; the repo is hosted on Cloudflare R2.</p>
<%- if pipeline_api_url -%>
  <p id="pipeline" class="pipeline" data-api="<%= h pipeline_api_url %>" hidden></p>
<%- end -%>
  <nav><a href="#signing-key">Key</a><% if source_url %><a href="<%= h source_url %>">GitHub</a><% end %></nav>
</header>

<div class="distro-tabs" id="distro-tabs" role="tablist" aria-label="Distribution" hidden>
<%- distros.each do |distro| -%>
  <button type="button" role="tab" data-distro="<%= h distro.id %>" aria-controls="<%= h distro.id %>"><%= h distro.name %></button>
<%- end -%>
</div>

<main>
<%- distros.each do |distro| -%>
<div class="distro" id="<%= h distro.id %>" role="tabpanel">
<h2 class="distro-name"><%= h distro.name %></h2>
<section id="<%= h distro.id %>-install">
  <h3>Install</h3>
  <ol class="steps">
<%- distro.commands.each do |command| -%>
    <li>
      <p class="step-label"><%= h command.label %></p>
      <div class="code-block">
        <pre id="<%= h command.id %>"><code><%= h command.text %></code></pre>
        <button type="button" class="copy-btn" data-target="<%= h command.id %>" hidden>Copy</button>
      </div>
    </li>
<%- end -%>
  </ol>
  <p class="note">Step 3 replaces openSUSE and Packman builds with these.</p>
</section>

<section id="<%= h distro.id %>-repository">
  <details class="collapsible">
  <summary><h3>Repo</h3></summary>
<%- if distro.published -%>
  <dl class="facts">
    <dt>Repo file</dt><dd><a href="<%= h distro.repo_file_url %>"><%= h distro.repo_file_url %></a></dd>
<%- distro.baseurls.each do |baseurl| -%>
    <dt><%= h baseurl.arch %></dt><dd><code><%= h baseurl.url %></code></dd>
<%- end -%>
    <dt><%= h distro.name %></dt><dd><% if distro.distro_snapshot %><%= h distro.distro_snapshot %><% else %>unknown<% end %></dd>
    <dt>Updated</dt><dd><% if distro.generated_at %><time datetime="<%= h distro.generated_at_iso %>"><%= h distro.generated_at %></time><% else %>unknown<% end %></dd>
    <dt>Run</dt><dd><%= h distro.run %><% if distro.release %> <code><%= h distro.release %></code><% end %></dd>
    <dt>Packages</dt><dd><%= h distro.totals.succeeded %> of <%= h distro.totals.packages %> built</dd>
    <dt>Files</dt><dd><%= h distro.totals.binary_rpms %> rpms, <%= h distro.totals.source_rpms %> src, <%= h distro.totals.size %></dd>
    <dt>JSON</dt><dd><a href="<%= h distro.packages_url %>">packages.json</a></dd>
  </dl>
<%- else -%>
  <p>Not published yet.</p>
<%- end -%>
  </details>
</section>

<%- if distro.published -%>
<section id="<%= h distro.id %>-packages">
  <details class="collapsible">
  <summary><h3>Packages</h3></summary>
  <table>
    <thead>
      <tr><th>Package</th><th>Version</th><th>Origin</th><th>Status</th><th>Built</th><th>Files</th></tr>
    </thead>
    <tbody>
<%- distro.packages.each do |package| -%>
      <tr id="<%= h package.anchor %>">
        <td data-label="Package"><a class="name" href="#<%= h package.anchor %>"><%= h package.name %></a></td>
        <td data-label="Version"><% if package.evr %><code><%= h package.evr %></code><% else %><span class="muted">unknown</span><% end %></td>
        <td data-label="Origin"><div><% if package.origin_url %><a href="<%= h package.origin_url %>"><%= h package.origin_label %></a><% else %><%= h package.origin_label %><% end %><span class="kind"><%= h package.kind %></span></div></td>
        <td data-label="Status"><div><span class="status status-<%= h package.status_class %>"><%= h package.status %></span><% if package.last_run %> <span class="muted">run <%= h package.last_run %></span><% end %><% if package.reason_label %><details class="reason"><summary><%= h package.reason_label %></summary><%= h package.reason_detail %></details><% elsif package.reason %><span class="reason"><%= h package.reason %></span><% end %><% if package.log_url %><a class="log" href="<%= h package.log_url %>">build log</a><% end %><% if package.uninstallable.any? %><details class="reason problem"><summary>not installable</summary><% package.uninstallable.each do |line| %><div><%= h line %></div><% end %></details><% end %></div></td>
        <td data-label="Built"><% if package.built_at %><time datetime="<%= h package.built_at_iso %>"><%= h package.built_at %></time><% else %><span class="muted">never</span><% end %></td>
        <td data-label="Files"><div><% if package.files.any? %><button type="button" class="files-toggle" aria-expanded="false" aria-controls="files-<%= h package.anchor %>" hidden><%= h package.files.size %> rpms</button><% else %><span class="muted">none</span><% end %><% if package.retained %><span class="reason">from last good build</span><% end %></div></td>
      </tr>
<%- if package.files.any? -%>
      <tr class="files-row" id="files-<%= h package.anchor %>">
        <td colspan="6"><ul class="files"><% package.files.each do |file| %><li><a href="<%= h file.url %>"><%= h file.name %></a><span class="muted"><%= h file.size %></span></li><% end %></ul></td>
      </tr>
<%- end -%>
<%- end -%>
    </tbody>
  </table>
  </details>
</section>
<%- end -%>
</div>
<%- end -%>

<section id="about">
  <h2>Why</h2>
  <p>openSUSE ships ffmpeg, GStreamer and VLC with patent-encumbered codecs removed, and its openh264 repo adds only H.264.
  Packman Essentials filled the gap: full ffmpeg 4 to 9, x264, x265, fdk-aac, the GStreamer bad and ugly codecs, VLC codecs, libdvdcss and more.
  packman-nova builds the same packages for Tumbleweed and Leap 16 with its own signing key.</p>
  <h2>Migrating from Packman</h2>
  <p>Find the Packman repo alias with <code>zypper lr</code>, remove it with <code>sudo zypper rr &lt;alias&gt;</code>, then follow the install steps above.
  Step 3 moves installed Packman packages to these builds.</p>
</section>

<section id="signing-key">
  <h2>Key</h2>
<%- if key -%>
  <dl class="facts">
    <dt>Key ID</dt><dd><code><%= h key.id %></code></dd>
    <dt>Fingerprint</dt><dd><code><%= h key.fingerprint %></code></dd>
    <dt>File</dt><dd><a href="<%= h key_url %>"><%= h key_url %></a></dd>
  </dl>
<%- else -%>
  <p>No signing key recorded. <a href="<%= h key_url %>"><%= h key_url %></a></p>
<%- end -%>
</section>
</main>

<footer>
<%- if source_url -%>
  <p>Source: <a href="<%= h source_url %>"><%= h source_url %></a></p>
<%- end -%>
  <p>Inspired by <a href="https://omnipackage.org">omnipackage.org</a>.</p>
<%- if generated_at -%>
  <p>Updated <%= h generated_at %>.</p>
<%- end -%>
</footer>
</div>
<script>
var pipeline = document.getElementById('pipeline');
if (pipeline && window.fetch) {
  fetch(pipeline.dataset.api).then(function (response) {
    return response.ok ? response.json() : null;
  }).then(function (data) {
    var run = data && data.workflow_runs && data.workflow_runs[0];
    if (!run) return;
    var time = function (iso) { return iso.slice(0, 16).replace('T', ' ') + ' UTC'; };
    var words = { success: 'succeeded', failure: 'failed', timed_out: 'timed out', startup_failure: 'failed to start' };
    var running = run.status !== 'completed';
    var failed = ['failure', 'timed_out', 'startup_failure'].indexOf(run.conclusion) >= 0;
    var link = document.createElement('a');
    link.href = run.html_url;
    link.textContent = running ? 'Build #' + run.run_number + ' running since ' + time(run.run_started_at || run.created_at)
      : 'Last build #' + run.run_number + ' ' + (words[run.conclusion] || run.conclusion || run.status) + ', ' + time(run.updated_at);
    pipeline.appendChild(link);
    pipeline.classList.add(running ? 'pipeline-running' : failed ? 'pipeline-failed' : run.conclusion === 'success' ? 'pipeline-ok' : 'pipeline-other');
    pipeline.hidden = false;
  }).catch(function () {});
}
document.querySelectorAll('.files-toggle').forEach(function (button) {
  var row = document.getElementById(button.getAttribute('aria-controls'));
  row.hidden = true;
  button.hidden = false;
  button.addEventListener('click', function () {
    var open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    row.hidden = !open;
    button.closest('tr').classList.toggle('expanded', open);
  });
});
var distroTabs = document.getElementById('distro-tabs');
var distroPanels = Array.prototype.slice.call(document.querySelectorAll('.distro'));
var selectDistro = function (id) {
  distroPanels.forEach(function (panel) { panel.hidden = panel.id !== id; });
  distroTabs.querySelectorAll('button').forEach(function (button) {
    button.setAttribute('aria-selected', String(button.dataset.distro === id));
  });
};
var distroOf = function (id) {
  var target = id && document.getElementById(id);
  var panel = target && target.closest('.distro');
  return panel ? panel.id : null;
};
var reveal = function (id) {
  var target = id && document.getElementById(id);
  var details = target && target.closest('details.collapsible');
  if (details) details.open = true;
  return target;
};
var hashTarget = function () {
  try { return decodeURIComponent(location.hash.slice(1)); } catch (e) { return ''; }
};
var storedDistro = null;
try { storedDistro = localStorage.getItem('distro'); } catch (e) {}
if (distroPanels.length) {
  var initialTarget = hashTarget();
  selectDistro(distroOf(initialTarget) || distroOf(storedDistro) || distroPanels[0].id);
  if (initialTarget && distroOf(initialTarget)) reveal(initialTarget).scrollIntoView();
  distroTabs.hidden = false;
  distroTabs.addEventListener('click', function (event) {
    var button = event.target.closest('button');
    if (!button) return;
    selectDistro(button.dataset.distro);
    history.replaceState(null, '', '#' + button.dataset.distro);
    try { localStorage.setItem('distro', button.dataset.distro); } catch (e) {}
  });
  window.addEventListener('hashchange', function () {
    var target = hashTarget();
    var id = distroOf(target);
    if (id) selectDistro(id);
    reveal(target);
  });
}
var themeToggle = document.getElementById('theme-toggle');
var applyTheme = function (mode) {
  document.documentElement.dataset.theme = mode;
  themeToggle.querySelectorAll('button').forEach(function (button) {
    button.setAttribute('aria-pressed', String(button.dataset.mode === mode));
  });
};
applyTheme(document.documentElement.dataset.theme || '');
themeToggle.hidden = false;
themeToggle.addEventListener('click', function (event) {
  var button = event.target.closest('button');
  if (!button) return;
  applyTheme(button.dataset.mode);
  try { localStorage.setItem('theme', button.dataset.mode); } catch (e) {}
});
if (navigator.clipboard) {
  document.querySelectorAll('.copy-btn').forEach(function (button) {
    button.hidden = false;
    button.addEventListener('click', function () {
      var text = document.getElementById(button.dataset.target).textContent;
      navigator.clipboard.writeText(text).then(function () {
        button.textContent = 'Copied';
        button.classList.add('copied');
        setTimeout(function () {
          button.textContent = 'Copy';
          button.classList.remove('copied');
        }, 1500);
      });
    });
  });
}
</script>
</body>
</html>
